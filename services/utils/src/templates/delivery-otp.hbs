<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Zesto Delivery OTP</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f7f6; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f4f7f6; padding: 40px 10px;">
    <tr>
      <td align="center">
        <table width="100%" max-width="600" cellpadding="0" cellspacing="0" border="0" style="background-color: #ffffff; max-width: 600px; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
          
          <tr>
            <td align="center" style="background-color: #FF69B4; padding: 30px 20px;">
              <h1 style="margin: 0; color: #ffffff; font-size: 32px; font-weight: 800; letter-spacing: 1px;">Zesto</h1>
            </td>
          </tr>

          <tr>
            <td style="padding: 40px 30px; color: #333333;">
              <p style="margin: 0 0 15px 0; font-size: 18px;">Hi <strong>{{userName}}</strong>,</p>
              
              <p style="margin: 0 0 25px 0; font-size: 16px; line-height: 1.5; color: #555555;">
                Your order <strong>#{{orderId}}</strong> is arriving soon! To ensure a secure delivery, please share the following One-Time Password (OTP) with your rider.
              </p>

              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" style="padding: 10px 0 30px 0;">
                    <div style="display: inline-block; padding: 15px 40px; background-color: #FFF0F5; border: 2px dashed #FF69B4; border-radius: 8px; color: #FF69B4; font-size: 36px; font-weight: bold; letter-spacing: 8px;">
                      {{otpCode}}
                    </div>
                  </td>
                </tr>
              </table>

              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #fff9fa; border-left: 4px solid #FF69B4; border-radius: 4px;">
                <tr>
                  <td style="padding: 15px; font-size: 14px; color: #666666; line-height: 1.5;">
                    <strong style="color: #FF69B4;">Security Notice:</strong> This code was generated at <em>{{timestamp}}</em> and is strictly valid for <strong>1 hour</strong>. Please do not share this code with anyone over the phone; only give it to the rider in person.
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <tr>
            <td align="center" style="background-color: #fcfcfc; border-top: 1px solid #eeeeee; padding: 25px 20px;">
              <p style="margin: 0 0 10px 0; font-size: 13px; color: #999999;">
                &copy; 2026 Zesto. All rights reserved.
              </p>
              <p style="margin: 0; font-size: 12px; color: #aaaaaa; text-transform: uppercase; letter-spacing: 1px;">
                Crafted and developed by Pratik singh
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>